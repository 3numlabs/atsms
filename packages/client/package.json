{
  "name": "@atsms/client",
  "type": "module",
  "version": "0.1.0",
  "description": "ATSMS client SDK: end-to-end encrypted messaging and calling on AT Protocol identities",
  "main": "dist/index.js",
  "module": "dist/index.browser.js",
  "types": "dist/index.d.ts",
  "react-native": "dist/index.native.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.native.js",
      "browser": "./dist/index.browser.js",
      "node": "./dist/index.js",
      "default": "./dist/index.browser.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "clean": "rm -rf dist .build-tmp",
    "build": "bun run clean && bun run build-lib && bun run build-types",
    "build-lib": "mkdir -p dist && bun run build-browser && bun run build-node && bun run build-rn",
    "build-browser": "bun build ./src/lib/index.ts --outfile=dist/index.browser.js --target=browser --minify --external ws --external better-sqlite3",
    "build-node": "bun build ./src/lib/index.ts --outfile=dist/index.js --target=node --minify --external ws --external better-sqlite3",
    "build-rn": "bun build ./src/lib/index.ts --outfile=dist/index.native.js --target=browser --minify --external ws --external better-sqlite3",
    "build-types": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepublishOnly": "bun run build",
    "test": "bun test src/tests",
    "test:watch": "bun test --watch src/tests",
    "lint": "eslint --cache src",
    "lint:fix": "eslint --cache --fix src",
    "format": "prettier --cache --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --cache --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\""
  },
  "dependencies": {
    "@atproto/api": "^0.18.5",
    "@noble/hashes": "^2.0.1",
    "@noble/secp256k1": "^3.0.0",
    "@peculiar/asn1-cms": "^2.4.0",
    "@peculiar/webcrypto": "^1.5.0",
    "@peculiar/x509": "^1.13.0",
    "asn1js": "^3.0.6",
    "jose": "^6.0.12",
    "nanoid": "^5.1.6",
    "pkijs": "3.2.5",
    "pvtsutils": "^1.3.6",
    "rxjs": "^7.8.0",
    "zod": "^4.1.12",
    "@atsms/dcgka": "file:../dcgka",
    "@noble/curves": "^1.9.7",
    "@noble/ciphers": "^1.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "24.2.0",
    "@types/prompts": "^2.4.9",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "bun-types": "^1.3.1",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.6.2",
    "prompts": "^2.4.2",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.46.2"
  },
  "keywords": [
    "atproto",
    "bluesky",
    "atsms",
    "secure-messaging",
    "smtp",
    "smime",
    "encryption",
    "x509",
    "pki"
  ],
  "author": "3NUM",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/atsms/at-sms.git"
  },
  "bugs": {
    "url": "https://github.com/atsms/at-sms/issues"
  },
  "homepage": "https://github.com/atsms/at-sms#readme"
}
